<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.labactivity31.ui.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.labactivity31.ui.AccountFragment"
        android:label="@string/title_account"
        tools:layout="@layout/fragment_account" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.labactivity31.ui.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/mySportsFragment"
        android:name="com.example.labactivity31.ui.MySportsFragment"
        android:label="@string/title_my_sports"
        tools:layout="@layout/fragment_my_sports">
        <action
            android:id="@+id/action_mySportsFragment_to_sportDetailFragment"
            app:destination="@id/sportDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/sportDetailFragment"
        android:name="com.example.labactivity31.ui.SportDetailFragment"
        android:label="Sport Details"
        tools:layout="@layout/fragment_sport_detail">
        <argument
            android:name="sportId"
            app:argType="string"
            android:defaultValue="football" />
    </fragment>

</navigation>